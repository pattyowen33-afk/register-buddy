{
  "name": "register-buddy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start":"npm rebuild better-sqlite3 && node server/index.js",	
    "dev": "concurrently -n \"API,Vite\" -c \"blue,green\" \"node --watch server/index.js\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "scrape": "node server/scraper/index.js",
    "scrape:live": "node server/scraper/live-scraper.js",
    "server": "node server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.14",
    "puppeteer": "^25.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
